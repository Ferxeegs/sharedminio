# --- MinIO root (administrator only; never use in application code) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-root-password

# Host path for object data (production: /srv/sharedminio/data)
MINIO_DATA_PATH=./data

# Public endpoint used by apps / presigned URLs / Console
# Local:
#   MINIO_SERVER_URL=http://127.0.0.1:9000
#   MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
# Production (direct MinIO, no nginx):
#   MINIO_SERVER_URL=http://<minio-host>:9000
#   MINIO_BROWSER_REDIRECT_URL=http://<minio-host>:9001
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
MINIO_SERVER_URL=http://127.0.0.1:9000

# Host port for MinIO S3 API (maps to container :9000)
# Restrict via host firewall to trusted app hosts only.
MINIO_API_PORT=9000

# Host port for MinIO Console UI (maps to container :9001)
MINIO_CONSOLE_PORT=9001

# --- Purchasing Go application user (least privilege) ---
PURCHASING_GO_ACCESS_KEY=purchasing-go
PURCHASING_GO_SECRET_KEY=change-me-purchasing-go-secret

# --- Siperbook application user (least privilege) ---
SIPERBOOK_ACCESS_KEY=siperbook
SIPERBOOK_SECRET_KEY=change-me-siperbook-secret

# --- dpupk-skp application user (least privilege) ---
SKP_ACCESS_KEY=skp
SKP_SECRET_KEY=change-me-skp-secret

# --- Prometheus / Grafana ---
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
GRAFANA_PORT=3030
